{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Smolevich/alerts-check/v1/alerts.schema.json",
  "title": "alerts.yaml — что в проекте считать поломкой",

  "x-версия": 1,
  "x-версия-описание": "Номер этого файла. Растёт, когда ранее правильный конфиг становится неправильным: по нему репозиторий видит, что заготовку пора обновить, и им же будет помечена опубликованная схема.",

  "x-подстановки": {
    "ЧАТ_АДМИНА": "личка Стаса в Telegram",
    "ЧАТ_ГРУППЫ": "общая группа (Laviolab)",
    "ЧАТ_ВЛАДЕЛЬЦА": "личка владельца проекта, если он не Стас",
    "ИМЯ_БОТА": "@имя телеграм-бота этого проекта",
    "АДРЕС_САЙТА": "домен сайта проекта, без схемы и слэша",
    "ХОСТ_СЕРВЕРА": "адрес машины, где проект живёт",
    "ДОМЕН_ПАРКА": "общий домен парка",
    "АДРЕС_API_БОТА": "хост:порт внутреннего Bot API проекта, без схемы (схема остаётся в конфиге)"
  },

  "type": "object",
  "additionalProperties": false,
  "required": ["версия", "проект", "куда-слать", "как-часто", "наблюдение"],
  "properties": {
    "версия": {
      "const": 1,
      "description": "Формат файла. Пока единственный."
    },
    "проект": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,30}$",
      "description": "Короткое имя проекта латиницей — попадает в текст тревоги."
    },
    "владелец": {
      "type": "string",
      "minLength": 1,
      "description": "Кому этот проект принадлежит. Только для человека."
    },
    "куда-слать": { "$ref": "#/$defs/адресат" },
    "как-часто": {
      "$ref": "#/$defs/длительность",
      "description": "Общий интервал проверок. Любой пункт может задать свой."
    },
    "наблюдение": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Виды того, за чем следим. Пустой файл без наблюдения бессмыслен.",
      "properties": {
        "телеграм-бот": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/бот" }
        },
        "сайт": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/сайт" }
        },
        "воркеры": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/воркер" }
        },
        "запасы": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/запас" }
        }
      }
    }
  },

  "$defs": {
    "длительность": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(с|м|ч|д)$",
      "description": "Число и единица: с — секунды, м — минуты, ч — часы, д — дни."
    },

    "строка": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{[А-ЯЁA-Z0-9_]{2,40}\\})+$",
      "description": "Обычная строка. Может содержать подстановки ${ИМЯ}; сами имена сверяются со списком x-подстановки."
    },

    "адресат": {
      "type": "object",
      "additionalProperties": false,
      "required": ["адресат"],
      "properties": {
        "адресат": {
          "$ref": "#/$defs/строка",
          "description": "Куда слать: id чата или подстановка вроде ${ЧАТ_ГРУППЫ}."
        },
        "повторять-не-чаще": {
          "$ref": "#/$defs/длительность",
          "description": "Пока поломка держится, не напоминать чаще этого."
        },
        "текст": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[^{}]|\\{(?:иконка|проект|что|подробности|время)\\})+$",
          "description": "Шаблон сообщения. Поля: {иконка} {проект} {что} {подробности} {время}."
        }
      }
    },

    "бот": {
      "type": "object",
      "additionalProperties": false,
      "required": ["имя"],
      "anyOf": [
        { "required": ["не-отвечает"] },
        { "required": ["очередь-растёт"] },
        { "required": ["ошибка-доставки"] }
      ],
      "description": "Бот без единого условия — сторож, который не может залаять.",
      "properties": {
        "имя": { "type": "string", "minLength": 1 },
        "бот": { "$ref": "#/$defs/строка" },
        "адрес-api": {
          "allOf": [
            { "$ref": "#/$defs/строка" },
            { "pattern": "^https?://[^/\\s]" }
          ],
          "description": "Где спрашивать состояние бота, если это не api.telegram.org. У бота на своём Bot API облако знает только старое: там числятся сотни необработанных обновлений, которых на самом деле нет."
        },
        "как-часто": { "$ref": "#/$defs/длительность" },
        "куда-слать": { "$ref": "#/$defs/адресат" },
        "не-отвечает": {
          "type": "object",
          "additionalProperties": false,
          "required": ["проверок-подряд"],
          "properties": {
            "проверок-подряд": { "type": "integer", "minimum": 1, "maximum": 20 },
            "ждать-не-дольше": { "$ref": "#/$defs/длительность" }
          }
        },
        "очередь-растёт": {
          "type": "object",
          "additionalProperties": false,
          "required": ["замеров-подряд", "больше-чем"],
          "description": "Очередь растёт и не убывает несколько замеров подряд.",
          "properties": {
            "замеров-подряд": { "type": "integer", "minimum": 2, "maximum": 20 },
            "больше-чем": { "type": "integer", "minimum": 1 }
          }
        },
        "ошибка-доставки": {
          "type": "object",
          "additionalProperties": false,
          "required": ["свежее"],
          "description": "Ошибка доставки, которая случилась только что и очередь при этом не пуста. Telegram помнит ПОСЛЕДНЮЮ ошибку навсегда, поэтому «давняя ошибка» тревогой быть не может: она означала бы вечный крик про то, что уже починено.",
          "properties": {
            "свежее": { "$ref": "#/$defs/длительность" }
          }
        }
      }
    },

    "сайт": {
      "type": "object",
      "additionalProperties": false,
      "required": ["имя", "адрес", "ждать-код"],
      "properties": {
        "имя": { "type": "string", "minLength": 1 },
        "адрес": {
          "allOf": [
            { "$ref": "#/$defs/строка" },
            {
              "pattern": "^https?://[^/\\s]",
              "description": "адрес должен начинаться с http:// или https:// и иметь непустой хост"
            }
          ],
          "description": "Полный адрес проверки. Хост не может быть пустым."
        },
        "ждать-код": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "description": "Коды, которые считаем нормой. Всё прочее — поломка."
        },
        "не-дольше": { "$ref": "#/$defs/длительность" },
        "проверок-подряд": { "type": "integer", "minimum": 1, "maximum": 20 },
        "как-часто": { "$ref": "#/$defs/длительность" },
        "куда-слать": { "$ref": "#/$defs/адресат" }
      }
    },

    "воркер": {
      "type": "object",
      "additionalProperties": false,
      "required": ["имя"],
      "anyOf": [
        { "required": ["молчит-дольше"] },
        { "required": ["падений-подряд"] }
      ],
      "description": "Воркер без условий молчания и падений не наблюдается ни за чем.",
      "properties": {
        "имя": { "type": "string", "minLength": 1 },
        "служба": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._-]+\\.(service|timer)$",
          "description": "Имя systemd-юнита."
        },
        "очередь": {
          "type": "string",
          "minLength": 1,
          "description": "Очередь задач, если воркер не systemd-юнит."
        },
        "молчит-дольше": { "$ref": "#/$defs/длительность" },
        "падений-подряд": { "type": "integer", "minimum": 1, "maximum": 20 },
        "как-часто": { "$ref": "#/$defs/длительность" },
        "куда-слать": { "$ref": "#/$defs/адресат" }
      }
    },

    "запас": {
      "type": "object",
      "additionalProperties": false,
      "required": ["имя"],
      "anyOf": [
        { "required": ["осталось-меньше"] },
        { "required": ["хватит-меньше-чем-на"] }
      ],
      "dependentRequired": {
        "осталось-меньше": ["единица"]
      },
      "description": "То, что кончается молча: деньги, место, квота, срок.",
      "properties": {
        "имя": { "type": "string", "minLength": 1 },
        "осталось-меньше": { "type": "number", "exclusiveMinimum": 0 },
        "единица": {
          "type": "string",
          "enum": ["доллары", "гигабайты", "штуки", "проценты", "дни"]
        },
        "хватит-меньше-чем-на": { "$ref": "#/$defs/длительность" },
        "как-часто": { "$ref": "#/$defs/длительность" },
        "куда-слать": { "$ref": "#/$defs/адресат" }
      }
    }
  }
}
